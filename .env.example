# El modo seguro viene activado. No envía mensajes ni escribe en Supabase.
FUELINTEL_DRY_RUN=true
FUELINTEL_TELEGRAM_ENABLED=false
FUELINTEL_TIMEZONE=America/Guayaquil
FUELINTEL_DATA_DIR=./data
FUELINTEL_SOURCES_FILE=./config/sources.json
FUELINTEL_DASHBOARD_HOURS=5
FUELINTEL_INTRADAY_ENABLED=true
FUELINTEL_INTRADAY_INTERVAL_SECONDS=60
FUELINTEL_INTRADAY_ALERT_COOLDOWN_MINUTES=30
FUELINTEL_NEWS_MAX_AGE_HOURS=36
FUELINTEL_REQUEST_TIMEOUT_SECONDS=20
FUELINTEL_SUPABASE_SYNC_MINUTES=10
FUELINTEL_ENV_FILE=./data/secrets/telegram.env
FUELINTEL_BRAND_NAME=@combustibleEc

# Configurar solo en Oracle; nunca subir estas claves al repositorio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EIA_API_KEY=
AISSTREAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
